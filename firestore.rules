rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isParty() {
      return signedIn() && (
        resource.data.lawyerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (resource.data.role == 'lawyer' && resource.data.verificationStatus == 'verified'));
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','verificationStatus','barCouncilVerified']);
    }

    match /cases/{id} {
      allow read: if isParty() || isAdmin();
      allow create: if signedIn() && (request.resource.data.lawyerId == request.auth.uid || request.resource.data.clientId == request.auth.uid);
      allow update, delete: if isParty() || isAdmin();
    }

    match /hearings/{id} {
      allow read: if isParty() || isAdmin();
      allow create, update, delete: if signedIn() && request.resource.data.lawyerId == request.auth.uid;
    }

    match /invoices/{id} {
      allow read: if isParty() || isAdmin();
      allow create: if signedIn() && request.resource.data.lawyerId == request.auth.uid;
      allow update: if isParty();
    }

    match /documents/{id} {
      allow read: if isParty() || isAdmin();
      allow create, update, delete: if signedIn() && (isParty() || request.resource.data.lawyerId == request.auth.uid || request.resource.data.clientId == request.auth.uid);
    }

    match /threads/{t} {
      allow read: if signedIn() && request.auth.uid in [resource.data.lawyerId, resource.data.clientId];
      allow create: if signedIn() && (request.resource.data.lawyerId == request.auth.uid || request.resource.data.clientId == request.auth.uid);
      allow update: if signedIn() && request.auth.uid in [resource.data.lawyerId, resource.data.clientId];
      match /messages/{m} {
        allow read, create: if signedIn() && request.auth.uid in [get(/databases/$(database)/documents/threads/$(t)).data.lawyerId, get(/databases/$(database)/documents/threads/$(t)).data.clientId];
      }
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if signedIn();
    }

    match /verification_requests/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /forum/{p} {
      allow read: if signedIn();
      allow write: if signedIn();
      match /replies/{r} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    match /firms/{firmId} {
      allow read, write: if signedIn();
      match /members/{memberId} {
        allow read, write: if signedIn();
      }
    }

    match /ai_briefs/{id} {
      allow read: if isParty() || isAdmin();
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if signedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
    }

    match /tasks/{id} {
      allow read, write: if signedIn();
    }

    match /feedbacks/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
    }
  }
}
