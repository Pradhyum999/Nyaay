rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'pradhumb1998@gmail.com'
      );
    }

    function isParty() {
      return signedIn() && (
        resource.data.lawyerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /cases/{id} {
      allow read: if signedIn() && (isParty() || isAdmin() || resource == null);
      allow create: if signedIn();
      allow update, delete: if isParty() || isAdmin();
    }

    match /hearings/{id} {
      allow read: if signedIn() && (isParty() || isAdmin() || resource == null);
      allow create, update, delete: if signedIn();
    }

    match /invoices/{id} {
      allow read: if signedIn() && (isParty() || isAdmin() || resource == null);
      allow create, update: if signedIn();
    }

    match /documents/{id} {
      allow read: if signedIn() && (isParty() || isAdmin() || resource == null);
      allow create, update, delete: if signedIn();
    }

    match /threads/{t} {
      allow read, write: if signedIn();
      match /messages/{m} {
        allow read, write: if signedIn();
      }
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if signedIn();
    }

    match /verification_requests/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /forum/{p} {
      allow read: if true;
      allow write: if signedIn();
      match /replies/{r} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /firms/{firmId} {
      allow read, write: if signedIn();
      match /members/{memberId} {
        allow read, write: if signedIn();
      }
    }

    match /ai_briefs/{id} {
      allow read, write: if signedIn();
    }

    match /tasks/{id} {
      allow read, write: if signedIn();
    }

    match /feedbacks/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
    }
  }
}
